          "properties": {
            "false": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": {},
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                }
              ]
            },
            "true": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "additionalProperties": {},
                  "type": "object"
                },
                {
                  "items": {},
                  "type": "array"
                }
              ]
            }
          },
          "required": [
            "true",
            "false"
