    "model-context-protocol",
    "delegate",
    "llm",
    "tokens",
    "openai",
    "ai",
    "cli"
  ],
  "homepage": "https://github.com/art-ws/delegate-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/art-ws/delegate-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/art-ws/delegate-mcp/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "delegate-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "delegate-config.example.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
